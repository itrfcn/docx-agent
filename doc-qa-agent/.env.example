# ==================== LLM 配置（通义千问 / OpenAI 兼容接口） ====================
# API Key（必填）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# API Base URL（通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名称（通义千问: qwen-plus / qwen-turbo / qwen-max）
MODEL_NAME=qwen-plus

# ==================== Embedding 配置 ====================
# 本地 Embedding 模型名称（sentence-transformers）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ==================== 向量库持久化路径 ====================
CHROMA_PERSIST_DIR=./data/chroma

# ==================== 文档切片参数 ====================
# 建议 400 字左右，overlap 48~64
CHUNK_SIZE=400
CHUNK_OVERLAP=64

# ==================== 检索参数 ====================
RETRIEVER_TOP_K=4
# 相关性阈值（0~1，越高越严格）：低于该分数的片段不返回
# 开启重排后，该阈值只用于「重排不可用」时的降级路径
RELEVANCE_THRESHOLD=0.45

# ==================== 重排（两阶段检索：宽召回 → 精排） ====================
# 关闭后回退到单阶段向量检索；内网机器性能不足时可设为 0
RERANK_ENABLED=1
# 中文 cross-encoder 重排模型，首次使用需能下载（约 1.1GB）
RERANK_MODEL=BAAI/bge-reranker-base
# 送入重排的候选片段数
RERANK_CANDIDATES=30
# 重排分数（sigmoid 归一化到 0~1）低于该值则丢弃
RERANK_THRESHOLD=0.30

# ==================== OCR（扫描件 PDF / 图片） ====================
# PDF 页面文本少于该字符数时视为扫描页，自动触发 OCR；设为 0 可关闭自动 OCR
OCR_MIN_TEXT_CHARS=20
# 扫描页渲染 DPI：200 均衡，调高更清晰但明显更慢
OCR_DPI=200

# ==================== 管理口令 ====================
# 侧边栏上传/清空知识库需要输入此口令；留空则管理功能锁定
ADMIN_PASSWORD=admin@2026
